# Supabase (server-side). The ML service runs on a server, so it may use
# the service role key. Never expose this key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Face recognition
FACE_SIMULATION_MODE=true
FACE_SIMULATION_STUDENT_ID=2021CS001
FACE_MATCH_THRESHOLD=0.4
FACE_MODEL_NAME=buffalo_l

# CGPA prediction model
CGPA_MODEL_PATH=models/cgpa/cgpa_model.joblib
CGPA_MIN_SEMESTERS=3

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173